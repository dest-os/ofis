#!/bin/sh
set -e
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GRADLE_VERSION="8.9"
CACHE_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/dest-os-ares/gradle-$GRADLE_VERSION"
GRADLE_BIN="$CACHE_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$CACHE_DIR"
  TMP_ZIP="$CACHE_DIR/gradle.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$TMP_ZIP" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$TMP_ZIP" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  else
    echo "curl veya wget bulunamadı." >&2
    exit 1
  fi
  rm -rf "$CACHE_DIR/extracted"
  mkdir -p "$CACHE_DIR/extracted"
  unzip -q "$TMP_ZIP" -d "$CACHE_DIR/extracted"
  rm -f "$TMP_ZIP"
  FOUND="$CACHE_DIR/extracted/gradle-$GRADLE_VERSION/bin/gradle"
  if [ ! -x "$FOUND" ]; then
    echo "Gradle dağıtımı açılamadı." >&2
    exit 1
  fi
  ln -sf "$FOUND" "$GRADLE_BIN"
fi
exec "$GRADLE_BIN" "$@"
